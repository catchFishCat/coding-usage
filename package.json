{
  "name": "coding-usage",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first unified monitor for AI coding quota/usage across multi-provider subscriptions",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r --parallel run test",
    "build": "pnpm -r --parallel run build",
    "dev": "pnpm --filter @coding-usage/web dev",
    "daemon": "pnpm --filter @coding-usage/server dev",
    "cli": "pnpm --filter @coding-usage/cli start"
  },
  "keywords": [
    "ai",
    "quota",
    "monitoring",
    "copilot",
    "openai",
    "anthropic",
    "usage-tracking"
  ],
  "author": "coding-usage contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "prettier": "^3.4.2",
    "eslint": "^9.18.0"
  },
  "packageManager": "pnpm@9.15.4"
}
